{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/swiast/dist-parity/main/schemas/report-v1.schema.json",
  "title": "dist-parity JSON CLI report v1 (unreleased current-main schema)",
  "description": "One JSON object emitted by dist-parity --json, including input errors. This is a schema for current main, not a claim about the published v0.1.2 tag. Exit codes: 0 agreement, 1 mismatch, 2 invalid input. This schema does not cover release_preflight.py receipts.",
  "oneOf": [
    {
      "$ref": "#/$defs/comparison"
    },
    {
      "$ref": "#/$defs/inputError"
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "message",
        "field"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string"
        },
        "field": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "comparison": {
      "type": "object",
      "required": [
        "sdist",
        "wheel",
        "project",
        "version",
        "ok",
        "findings"
      ],
      "properties": {
        "sdist": {
          "type": "string"
        },
        "wheel": {
          "type": "string"
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "ok": {
          "type": "boolean"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      },
      "additionalProperties": false
    },
    "inputError": {
      "type": "object",
      "required": [
        "ok",
        "error",
        "findings"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array",
          "maxItems": 0
        }
      },
      "additionalProperties": false
    }
  }
}
